# Única variable que consume el frontend. Vite solo expone al navegador las que
# empiezan por VITE_, y las incrusta en el bundle: nunca pongas secretos aquí.
#
# Desarrollo (.env.development) — ruta relativa, resuelta por el proxy de Vite:
VITE_API_BASE=/api/v1
#
# Producción (.env.production) — URL absoluta del API:
# VITE_API_BASE=https://espol-club.alwaysdata.net/api/v1
