# Ruta relativa a propósito: vite.config.js reenvía /api a http://localhost:8000,
# así el navegador ve un solo origen y CORS no entra en juego durante el
# desarrollo. Si prefieres apuntar directo al backend, pon la URL absoluta y
# añade http://localhost:5173 a CORS_ALLOWED_ORIGINS en el .env de Django.
VITE_API_BASE=/api/v1
