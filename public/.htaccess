<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# InfinityFree sirve el sitio sobre Apache; sin este rewrite, recargar una ruta
# profunda (p. ej. /lider/miembros) devolvería 404.
