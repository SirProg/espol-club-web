# InfinityFree sirve el sitio sobre Apache.

# ── Rutas de la SPA ──────────────────────────────────────────────────────
# Sin este rewrite, recargar una ruta profunda (p. ej. /app/clubes o
# /lider/miembros) devolvería 404: solo existe index.html, y el enrutado lo
# resuelve React en el navegador. La condición !-f deja pasar los archivos
# reales, así que sw.js, el manifest y los assets se sirven tal cual.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ── Tipos MIME que Apache no conoce ──────────────────────────────────────
# Sin el tipo correcto el navegador ignora el manifest y la app deja de ser
# instalable: no aparece el botón.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml            .svg
  AddType font/woff2               .woff2
</IfModule>

# ── Caducidad ────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # index.html y el manifest se revalidan siempre: son la puerta de entrada.
  <FilesMatch "^(index\.html|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Los assets llevan hash en el nombre: si cambian, cambia su nombre, así que
  # se pueden cachear un año sin miedo a servir algo obsoleto.
  <FilesMatch "\.(js|css|woff2|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # El service worker nunca se cachea: es el archivo que decide si el resto
  # se actualiza. Si el navegador sirviera una copia vieja, un despliegue
  # nuevo podría no llegar nunca a quien ya tiene la app instalada.
  # Va DESPUÉS de la regla anterior a propósito: sw.js también termina en .js,
  # y en Apache el último "Header set" que coincide es el que gana.
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
